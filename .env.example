# Firebase configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Optional Supabase realtime configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WebRTC TURN server. Keep credentials private and inject them through hosting
# environment configuration; never commit real credentials.
VITE_TURN_URL=turn:turn.example.com:3478
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Together Room live coordination (Socket.IO + LiveKit token server)
VITE_SOCKET_SERVER_URL=https://duo-socket-server.onrender.com

# OneSignal Web Push App ID (Public frontend ID)
# IMPORTANT: Never place ONESIGNAL_REST_API_KEY in frontend .env files!
# The REST API key is strictly a server-only environment secret on the Node.js push server.
VITE_ONESIGNAL_APP_ID=e0bb43d0-355d-48de-bb9f-0caf33039abb
