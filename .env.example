# Firebase configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Optional Supabase realtime configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WebRTC TURN server. Keep credentials private and inject them through hosting
# environment configuration; never commit real credentials.
VITE_TURN_URL=turn:turn.example.com:3478
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Together Room live coordination (Socket.IO + WebRTC)
VITE_SOCKET_SERVER_URL=http://localhost:3001
