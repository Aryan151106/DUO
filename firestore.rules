rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if current user is an authorized member of a couple space
    function isCoupleMember(coupleId) {
      return request.auth != null && (
        (
          exists(/databases/$(database)/documents/couples/$(coupleId)) && (
            (request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members) ||
            get(/databases/$(database)/documents/couples/$(coupleId)).data.partnerA == request.auth.uid ||
            get(/databases/$(database)/documents/couples/$(coupleId)).data.partnerB == request.auth.uid
          )
        ) ||
        (
          exists(/databases/$(database)/documents/spaces/$(coupleId)) && (
            (request.auth.uid in get(/databases/$(database)/documents/spaces/$(coupleId)).data.members) ||
            get(/databases/$(database)/documents/spaces/$(coupleId)).data.partnerA == request.auth.uid ||
            get(/databases/$(database)/documents/spaces/$(coupleId)).data.partnerB == request.auth.uid
          )
        )
      );
    }

    // User Profiles: Only the owner and their paired partner can read a profile
    match /profiles/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.coupleId != null && isCoupleMember(resource.data.coupleId))
      );
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Couples collection & nested subcollections
    match /couples/{coupleId} {
      // 1. Only allow signed-in users to create an initial unpaired couple with themselves as the single member
      allow create: if request.auth != null &&
        request.resource.data.members.size() == 1 &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.locked == false;

      // 2. Allow reading if caller is a member, or if querying/looking up by invite code to join
      allow read: if request.auth != null && (isCoupleMember(coupleId) || resource.data.inviteCode != null);

      // 3. Update: Either an existing member updating couple preferences, or a second partner pairing with the invite code
      allow update: if request.auth != null && (
        isCoupleMember(coupleId) || (
          resource.data.locked == false &&
          resource.data.members.size() == 1 &&
          !(request.auth.uid in resource.data.members) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.size() == 2 &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'locked', 'partnerB', 'updatedAt'])
        )
      );

      allow delete: if isCoupleMember(coupleId);
      
      // Calls & WebRTC signaling subcollections
      match /calls/{callId} {
        allow read, write: if isCoupleMember(coupleId);
        
        match /{candCol}/{candId} {
          allow read, write: if isCoupleMember(coupleId);
        }
      }

      // Notifications subcollection
      match /notifications/{notifId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      // Activity Sessions (Study Space & Movie Night)
      match /sessions/{sessionId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      // Dedicated Reactions collection (messageId_userId)
      match /reactions/{reactionId} {
        allow read: if isCoupleMember(coupleId);
        allow create, update: if isCoupleMember(coupleId) &&
          request.auth.uid == request.resource.data.userId &&
          reactionId.matches('.*_' + request.auth.uid);
        allow delete: if isCoupleMember(coupleId) &&
          request.auth.uid == resource.data.userId;
      }

      // Doodles metadata collection
      match /doodles/{doodleId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      // Custom sounds metadata collection
      match /sounds/{soundId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      // Starred messages collection (messageId_userId)
      // Only the authenticated user can create, update, or delete their own starred items
      match /starredMessages/{starId} {
        allow read: if isCoupleMember(coupleId) &&
          (resource == null || resource.data.userId == request.auth.uid);
        allow create, update: if isCoupleMember(coupleId) &&
          request.auth.uid == request.resource.data.userId &&
          starId.matches('.*_' + request.auth.uid);
        allow delete: if isCoupleMember(coupleId) &&
          resource.data.userId == request.auth.uid;
      }

      // Shared Media index collection
      match /sharedMedia/{mediaId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      // Calendar Events
      match /events/{eventId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      // Online Game Sessions: Only couple members can read. Writes are strictly validated; client cannot forge winner results.
      match /gameSessions/{sessionId} {
        allow read: if isCoupleMember(coupleId);
        allow write: if isCoupleMember(coupleId) &&
          (!('result' in request.resource.data) || request.resource.data.result == null);
      }

      // Online Game Stats: Authoritative streak records written by backend server only; clients can read
      match /gameStats/{statId} {
        allow read: if isCoupleMember(coupleId);
        allow write: if false;
      }
      
      // All other nested collections (tasks, messages, scores, wishlist, nudges)
      match /{subcollection}/{document=**} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }

    // Spaces alias (if accessed via spaces/{spaceId})
    match /spaces/{spaceId} {
      allow create: if request.auth != null &&
        request.resource.data.members.size() == 1 &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.locked == false;

      allow read: if request.auth != null && (isCoupleMember(spaceId) || resource.data.inviteCode != null);

      allow update: if request.auth != null && (
        isCoupleMember(spaceId) || (
          resource.data.locked == false &&
          resource.data.members.size() == 1 &&
          !(request.auth.uid in resource.data.members) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.size() == 2 &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'locked', 'partnerB', 'updatedAt'])
        )
      );

      allow delete: if isCoupleMember(spaceId);

      match /calls/{callId} {
        allow read, write: if isCoupleMember(spaceId);
        match /{candCol}/{candId} {
          allow read, write: if isCoupleMember(spaceId);
        }
      }

      match /reactions/{reactionId} {
        allow read: if isCoupleMember(spaceId);
        allow create, update: if isCoupleMember(spaceId) && request.auth.uid == request.resource.data.userId;
        allow delete: if isCoupleMember(spaceId) && request.auth.uid == resource.data.userId;
      }

      match /starredMessages/{starId} {
        allow read: if isCoupleMember(spaceId) &&
          (resource == null || resource.data.userId == request.auth.uid);
        allow create, update: if isCoupleMember(spaceId) &&
          request.auth.uid == request.resource.data.userId &&
          starId.matches('.*_' + request.auth.uid);
        allow delete: if isCoupleMember(spaceId) &&
          resource.data.userId == request.auth.uid;
      }

      match /sharedMedia/{mediaId} {
        allow read, write: if isCoupleMember(spaceId);
      }

      match /gameSessions/{sessionId} {
        allow read: if isCoupleMember(spaceId);
        allow write: if isCoupleMember(spaceId) &&
          (!('result' in request.resource.data) || request.resource.data.result == null);
      }

      match /gameStats/{statId} {
        allow read: if isCoupleMember(spaceId);
        allow write: if false;
      }

      match /{subcollection}/{document=**} {
        allow read, write: if isCoupleMember(spaceId);
      }
    }

    // Helper function for togetherRooms authorization
    function isTogetherRoomMember(roomId) {
      return request.auth != null && (
        exists(/databases/$(database)/documents/togetherRooms/$(roomId)) && (
          request.auth.uid in get(/databases/$(database)/documents/togetherRooms/$(roomId)).data.memberUids ||
          get(/databases/$(database)/documents/togetherRooms/$(roomId)).data.hostUid == request.auth.uid
        )
      );
    }

    // Together Rooms (Study Space & Movie Night live coordination)
    match /togetherRooms/{roomId} {
      // Allow read for room members, room host, or anyone in the couple space
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.memberUids ||
        resource.data.hostUid == request.auth.uid ||
        isCoupleMember(resource.data.coupleId)
      );

      // Create: Host or initial member AND verified couple member
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.hostUid ||
        request.auth.uid in request.resource.data.memberUids
      ) && request.resource.data.coupleId != null && isCoupleMember(request.resource.data.coupleId);

      // Update: Restrict updates to authorized members and non-sensitive coordination fields
      allow update: if request.auth != null &&
        (
          request.auth.uid in resource.data.memberUids ||
          resource.data.hostUid == request.auth.uid ||
          (resource.data.coupleId != null && isCoupleMember(resource.data.coupleId))
        ) &&
        // Immutable security properties
        request.resource.data.hostUid == resource.data.hostUid &&
        request.resource.data.coupleId == resource.data.coupleId &&
        request.resource.data.roomName == resource.data.roomName &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.createdAt == resource.data.createdAt &&
        // Restricted writable fields (study timer, movie sync, revision, memberUids append, status, end info)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'study', 'movie', 'revision', 'status', 'endedAt', 'endedBy', 'memberUids', 'lastActiveAt'
        ]) &&
        // Status transition to 'ended' allowed for either room host or couple member
        (request.resource.data.status != 'ended' || resource.data.hostUid == request.auth.uid || (resource.data.coupleId != null && isCoupleMember(resource.data.coupleId)));

      // Delete: room host or couple member
      allow delete: if request.auth != null && (resource.data.hostUid == request.auth.uid || (resource.data.coupleId != null && isCoupleMember(resource.data.coupleId)));

      match /{subcollection}/{docId} {
        allow read, write: if isTogetherRoomMember(roomId);
      }
    }
  }
}
