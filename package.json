{
  "name": "duo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "socket-server": "node server/index.js",
    "socket-server:dev": "node --watch server/index.js",
    "socket-server:pm2:start": "pm2 start server/index.js --name duo-socket-server",
    "socket-server:pm2:stop": "pm2 stop duo-socket-server",
    "socket-server:pm2:restart": "pm2 restart duo-socket-server",
    "socket-server:pm2:status": "pm2 status",
    "socket-server:tunnel": "npx localtunnel --port 3001",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.4.0",
    "firebase": "^13.0.0",
    "livekit-client": "^2.22.4",
    "lucide-react": "^1.54.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-onesignal": "^3.5.6",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "firebase-admin": "^14.5.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
